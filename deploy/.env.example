# Copy to /volume1/docker/tesla-lyrics/compose/.env on the NAS and fill in (npm run deploy:nas-env
# does it for you). Never commit the real file.

# --- Spotify (developer.spotify.com/dashboard). The redirect URI must be registered there exactly.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
REDIRECT_URI=https://lyrics.monsted.org/callback

# --- main screen PIN and the key that signs its cookie (generate: openssl rand -hex 32)
PIN_CODE=
COOKIE_SECRET=

# --- lyrics fallbacks (optional)
GENIUS_ACCESS_TOKEN=
BRAVE_SEARCH_API_KEY=
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=gpt-4.1-mini

# --- Tessie skip (optional; both or neither)
TESSIE_API_TOKEN=
TESSIE_VIN=

# --- nas
IMAGE=ghcr.io/djoike/tesla-lyrics:latest
CLOUDFLARE_TUNNEL_TOKEN=
